parameters:
	ignoreErrors:
		-
			message: '#^Parameter \#2 \$callback of function array_filter expects \(callable\(string\)\: bool\)\|null, ''strlen'' given\.$#'
			identifier: argument.type
			count: 1
			path: wp-content/plugins/momos-core/src/Access/Http/CspReport.php

		-
			message: '#^Strict comparison using \!\=\= between ''0'' and non\-falsy\-string will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: wp-content/plugins/momos-core/src/Admin/Content/MediaFields.php

		-
			message: '#^Parameter \#1 \$args of function get_terms expects array\{taxonomy\?\: array\<string\>\|string, object_ids\?\: array\<int\>\|int, orderby\?\: string, order\?\: string, hide_empty\?\: bool\|int, include\?\: array\<int\>\|string, exclude\?\: array\<int\>\|string, exclude_tree\?\: array\<int\>\|string, \.\.\.\}, array\{taxonomy\: ''momo_branch_scope'', hide_empty\: false, meta_key\: ''momo_branch_id'', meta_value\: int, number\: 1\} given\.$#'
			identifier: argument.type
			count: 1
			path: wp-content/plugins/momos-core/src/Branch/PostType/BranchScopeTaxonomy.php

		-
			message: '#^Strict comparison using \=\=\= between ''0'' and non\-falsy\-string will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: wp-content/plugins/momos-core/src/Branch/Repository/BranchSettingsRepository.php

		-
			message: '#^Strict comparison using \!\=\= between ''0'' and non\-falsy\-string will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: wp-content/plugins/momos-core/src/Branch/Service/BranchPublishValidator.php

		-
			message: '#^Strict comparison using \!\=\= between ''0'' and non\-falsy\-string will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 2
			path: wp-content/plugins/momos-core/src/Branch/Service/SettingsValidator.php

		-
			message: '#^Strict comparison using \!\=\= between ''0'' and mixed~\(0\|0\.0\|''''\|''0''\|array\{\}\|false\|null\) will always evaluate to true\.$#'
			identifier: notIdentical.alwaysTrue
			count: 1
			path: wp-content/plugins/momos-core/src/Kernel/Fields/Sanitizer.php

		-
			message: '#^Call to function in_array\(\) with arguments ''Momos\\\\Admin\\\\Content\\\\ContentModule'', array\{''Momos\\\\Kernel\\\\I18n\\\\I18nModule'', ''Momos\\\\Access\\\\AccessModule'', ''Momos\\\\Audit\\\\AuditModule'', ''Momos\\\\Branch\\\\BranchModule'', ''Momos\\\\Menu\\\\MenuModule'', ''Momos\\\\Dietary\\\\DietaryModule'', ''Momos\\\\Reservation\\\\ReservationModule'', ''Momos\\\\Notification\\\\NotificationModule'', \.\.\.\} and true will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: wp-content/plugins/momos-core/src/Kernel/I18n/Admin/TranslationEditor.php

		-
			message: '#^Empty array passed to foreach\.$#'
			identifier: foreach.emptyArray
			count: 2
			path: wp-content/plugins/momos-core/src/Kernel/I18n/Translations.php

		-
			message: '#^Strict comparison using \=\=\= between ''0'' and non\-falsy\-string will always evaluate to false\.$#'
			identifier: identical.alwaysFalse
			count: 1
			path: wp-content/plugins/momos-core/src/Notification/Recipient/RecipientResolver.php

		-
			message: '#^Call to function is_string\(\) with string will always evaluate to true\.$#'
			identifier: function.alreadyNarrowedType
			count: 1
			path: wp-content/plugins/momos-core/src/Notification/Support/Brand.php

		-
			message: '#^Variable \$row might not be defined\.$#'
			identifier: variable.undefined
			count: 1
			path: wp-content/plugins/momos-core/src/Privacy/Cli/PrivacyCommand.php

		-
			message: '#^Parameter \#1 \$array \(non\-empty\-list\<array\{name\: string, url\: string\}\>\) of array_values is already a list, call has no effect\.$#'
			identifier: arrayValues.list
			count: 1
			path: wp-content/plugins/momos-core/src/Seo/Schema/JsonLd.php
